{
  "name": "@tower-of-habit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/vitest": "./src/testing/vitest.ts"
  },
  "scripts": {
    "migrate:dev": "drizzle-kit migrate",
    "migrate:test": "ENV_FILE=.env.test drizzle-kit migrate",
    "migrate:deploy": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:dev": "tsx src/seed/dev.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tower-of-habit/shared": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
