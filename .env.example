# --- Postgres ---
POSTGRES_USER=tower
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=tower
# Host port the dev overlay (docker-compose.dev.yml) publishes Postgres on, for
# host-run tooling (drizzle-kit, studio, dev:api). 5433, not 5432, so it never
# collides with a native Postgres install. Containers still use postgres:5432.
POSTGRES_HOST_PORT=5433
# Manual fill-in required: Docker's `env_file:` does NOT interpolate
# ${POSTGRES_PASSWORD} inside another var's value. After setting
# POSTGRES_PASSWORD above, copy the same value into PASSWORD below by hand.
# Host `postgres` is correct here — this file documents the in-container
# (api/worker via docker-compose.yml) connection string. For host-run dev
# tooling, see .env.dev, which uses `localhost:5433` (POSTGRES_HOST_PORT) instead.
DATABASE_URL=postgres://tower:PASSWORD@postgres:5432/tower

# --- pgAdmin (dev overlay only: docker-compose.dev.yml) ---
# Host port for the pgAdmin UI → http://localhost:5050
PGADMIN_HOST_PORT=5050

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth (2.9: passwordless email OTP) ---
# Phase 2 has no email provider yet, so the login code is written to the app log
# when this is true. MUST stay false in production (the app refuses to start with
# NODE_ENV=production and AUTH_CODE_LOG=true). Real email delivery lands in Phase 3.
AUTH_CODE_LOG=false

# --- Push (Phase 4) ---
EXPO_ACCESS_TOKEN=

# --- App ---
NODE_ENV=production
LOG_LEVEL=info
API_BASE_URL=https://api.yourdomain.com
# Comma-separated exact origins allowed by CORS (empty = none).
CORS_ORIGINS=
# Request bodies larger than this get 413 payload_too_large.
BODY_LIMIT_BYTES=1048576
# Max time to drain in-flight requests on SIGTERM before forcing exit.
# Keep under the container stop grace period (Compose default 10s).
SHUTDOWN_TIMEOUT_MS=8000
TOWER_VERSION=latest