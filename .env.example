# --- Postgres ---
POSTGRES_USER=tower
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=tower
# Host port the dev overlay (docker-compose.dev.yml) publishes Postgres on, for
# host-run tooling (drizzle-kit, studio, dev:api). 5433, not 5432, so it never
# collides with a native Postgres install. Containers still use postgres:5432.
POSTGRES_HOST_PORT=5433
# Manual fill-in required: Docker's `env_file:` does NOT interpolate
# ${POSTGRES_PASSWORD} inside another var's value. After setting
# POSTGRES_PASSWORD above, copy the same value into PASSWORD below by hand.
# Host `postgres` is correct here — this file documents the in-container
# (api/worker via docker-compose.yml) connection string. For host-run dev
# tooling, see .env.dev, which uses `localhost:5433` (POSTGRES_HOST_PORT) instead.
DATABASE_URL=postgres://tower:PASSWORD@postgres:5432/tower

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=                 # openssl rand -base64 48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Push (Phase 4) ---
EXPO_ACCESS_TOKEN=

# --- App ---
NODE_ENV=production
LOG_LEVEL=info
API_BASE_URL=https://api.yourdomain.com
TOWER_VERSION=latest